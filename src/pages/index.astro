---
/**
 * src/pages/index.astro — Agency Homepage
 *
 * Component-Driven Architecture layout orchestrator.
 * All content lives in @data/home.ts and @data/site.ts.
 * All complex logic lives encapsulated within the Organisms.
 */

import Layout from "@layouts/Layout.astro";
import Navbar from "@organisms/Navbar.astro";
import Footer from "@organisms/Footer.astro";
import Hero from "@organisms/Hero.astro";
import TrustTicker from "@organisms/TrustTicker.astro";
import BentoGrid from "@organisms/BentoGrid.astro";
import PortfolioReel from "@organisms/PortfolioReel.astro";
import StatsBar from "@organisms/StatsBar.astro";
import TestimonialsGrid from "@organisms/TestimonialsGrid.astro";
import ContactHub from "@organisms/ContactHub.astro";

import { SERVICES } from "@data/services";
import { navLinks, footerColumns } from "@data/site";
import { homeData } from "@data/home";
---

<Layout
  seo={{
    title:
      "TradeWeb — Motores de Venta Digital en Córdoba | Diseño Web, SEO y Marketing",
    description:
      "12 años transformando marcas con Diseño Web Premium, Marketing Estratégico e Identidad Visual en Córdoba y el mundo. Más de 280 proyectos entregados.",
    ogType: "website",
    jsonLd: {
      "@type": "ProfessionalService",
      name: "TradeWeb",
      description:
        "Agencia digital especializada en diseño web, SEO, publicidad digital e identidad visual en Córdoba, Argentina.",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Córdoba",
        addressCountry: "AR",
      },
      url: "https://tradeweb.com.ar",
      telephone: "+543515000000",
      priceRange: "$$",
      areaServed: ["Argentina", "Latinoamérica"],
    },
  }}
>
  <Navbar slot="navbar" links={navLinks} currentPath="/" logoText="TradeWeb" />

  <Hero
    id="hero"
    tagline={homeData.hero.tagline}
    title={homeData.hero.title}
    subtitle={homeData.hero.subtitle}
    actions={[
      {
        variant: "primary" as const,
        label: homeData.hero.actions.primary.label,
        href: homeData.hero.actions.primary.href,
      },
      {
        variant: "secondary" as const,
        label: homeData.hero.actions.secondary.label,
        href: homeData.hero.actions.secondary.href,
      },
    ]}
  >
    <Fragment slot="bg">
      <div
        id="hero-grid"
        aria-hidden="true"
        class="absolute inset-0 noise-overlay pointer-events-none"
        style="background-image: linear-gradient(var(--color-grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-grid-line) 1px, transparent 1px); background-size: 72px 72px; opacity: 0.5;"
      >
      </div>
      <div
        id="hero-glow-1"
        aria-hidden="true"
        class="absolute pointer-events-none will-change-transform"
        style="top: -20%; right: -10%; width: 70vw; height: 70vw; background: radial-gradient(circle, var(--color-glow-primary) 0%, transparent 65%); border-radius: 50%;"
      >
      </div>
      <div
        id="hero-glow-2"
        aria-hidden="true"
        class="absolute pointer-events-none will-change-transform"
        style="bottom: -10%; left: -15%; width: 60vw; height: 60vw; background: radial-gradient(circle, var(--color-glow-secondary) 0%, transparent 65%); border-radius: 50%;"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute inset-0 pointer-events-none overflow-hidden"
      >
        <div
          class="animate-scan-line absolute left-0 right-0 h-px opacity-10"
          style="background: linear-gradient(90deg, transparent, var(--color-brand-primary), transparent);"
        >
        </div>
      </div>
      <div
        aria-hidden="true"
        class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none"
        style="background: linear-gradient(to bottom, transparent, var(--color-surface-bg)); z-index: 10;"
      >
      </div>
    </Fragment>
    <Fragment slot="content">
      <div
        class="mt-20 flex flex-col items-center gap-3 text-muted text-xs font-mono opacity-70"
      >
        <div id="scroll-indicator" class="flex flex-col gap-1 items-center">
          <div
            class="w-px h-8 bg-gradient-to-b from-transparent to-brand-primary opacity-60 animate-pulse"
          >
          </div>
        </div>
        <p>{homeData.hero.scrollIndicator}</p>
      </div>
    </Fragment>
  </Hero>

  <section
    class="py-16 border-y border-surface relative overflow-hidden"
    aria-label="Clientes"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: linear-gradient(180deg, var(--color-surface-bg), var(--color-surface-overlay) 50%, var(--color-surface-bg));"
    >
    </div>
    <TrustTicker
      eyebrow={homeData.trustTicker.eyebrow}
      speed={40}
      class="relative z-base"
    />
  </section>

  <BentoGrid
    id="servicios"
    eyebrow={homeData.bentoGrid.eyebrow}
    title={homeData.bentoGrid.title}
    description={homeData.bentoGrid.description}
    ctaLabel={homeData.bentoGrid.ctaLabel}
    ctaHref={homeData.bentoGrid.ctaHref}
    items={SERVICES}
  />

  <PortfolioReel id="portfolio" />

  <StatsBar id="la-agencia" />

  <TestimonialsGrid id="testimonios" />

  <ContactHub id="contacto" />

  <Footer
    slot="footer"
    brandName="TradeWeb"
    brandTagline="12 años transformando marcas con diseño, tecnología y estrategia de marketing."
    columns={footerColumns}
    contact={{
      email: "hola@tradeweb.com.ar",
      phone: "+54 9 351 500-0000",
      address: "Córdoba, Argentina",
    }}
    social={{
      instagram: "https://instagram.com/tradeweb",
      linkedin: "https://linkedin.com/company/tradeweb",
      whatsapp: "https://wa.me/5493515000000",
    }}
    legal={{
      copyright: `© ${new Date().getFullYear()} TradeWeb. Todos los derechos reservados.`,
      links: [
        { label: "Política de privacidad", href: "/privacidad" },
        { label: "Términos de uso", href: "/terminos" },
      ],
    }}
  />
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initRevealAnimations = () => {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── DATA-REVEAL SCROLL ANIMATIONS ──────────────────────────────────────
    if (!prefersReduced) {
      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
        const dir = el.dataset.reveal ?? "up";
        const delay = parseFloat(el.dataset.revealDelay ?? "0");

        gsap.fromTo(
          el,
          {
            autoAlpha: 0,
            y: dir === "up" ? 28 : 0,
            x: dir === "left" ? 28 : dir === "right" ? -28 : 0,
          },
          {
            autoAlpha: 1,
            y: 0,
            x: 0,
            duration: 0.65,
            delay,
            ease: "power2.out",
            scrollTrigger: {
              trigger: el,
              start: "top 90%",
              once: true,
            },
          },
        );
      });

      document
        .querySelectorAll<HTMLElement>("[data-reveal-group]")
        .forEach((group) => {
          const items =
            group.querySelectorAll<HTMLElement>("[data-reveal-item]");
          if (items.length > 0) {
            gsap.fromTo(
              items,
              { autoAlpha: 0, y: 28 },
              {
                autoAlpha: 1,
                y: 0,
                duration: 0.55,
                ease: "power2.out",
                stagger: 0.1,
                scrollTrigger: {
                  trigger: group,
                  start: "top 88%",
                  once: true,
                },
              },
            );
          }
        });
    }
  };

  initRevealAnimations();
  document.addEventListener("astro:page-load", initRevealAnimations);
</script>

<style is:global>
  /* Base SR Only class for accessibility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
