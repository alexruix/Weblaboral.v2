---
/**
 * Icon.astro — Atom (Phosphor Integration)
 * Acts as a proxy wrapper mapping generic IconNames to @phosphor-icons/react.
 * Ensures backward compatibility across the entire project.
 */
import {
  Check,
  Star,
  ArrowRight,
  ArrowUpRight,
  CaretDown,
  X,
  Plus,
  Minus,
  Lightning,
  Target,
  Pen,
  Layout,
  MagnifyingGlass,
  ChatCircle,
  Clock,
  Shield,
  ShieldCheck,
  TrendUp,
  DeviceMobile,
  Globe,
  EnvelopeSimple,
  Phone,
  MapPin,
  InstagramLogo,
  LinkedinLogo,
  XLogo,
  WhatsappLogo,
} from "@phosphor-icons/react";

export type IconName =
  | "check"
  | "star"
  | "arrow-right"
  | "arrow-up-right"
  | "chevron-down"
  | "x"
  | "plus"
  | "minus"
  | "zap"
  | "target"
  | "pen"
  | "layout"
  | "search"
  | "message-circle"
  | "clock"
  | "shield"
  | "shield-check"
  | "trending-up"
  | "smartphone"
  | "globe"
  | "mail"
  | "phone"
  | "map-pin"
  | "instagram"
  | "linkedin"
  | "twitter"
  | "whatsapp";

interface Props {
  name: IconName;
  size?: number | string;
  color?: string;
  weight?: "regular" | "thin" | "light" | "bold" | "fill" | "duotone";
  class?: string;
  label?: string;
}

const {
  name,
  size = 20,
  color = "currentColor",
  weight = "regular",
  class: className,
  label,
} = Astro.props;

// Map generic strings to Phosphor React components
const IconMap: Record<IconName, any> = {
  check: Check,
  star: Star,
  "arrow-right": ArrowRight,
  "arrow-up-right": ArrowUpRight,
  "chevron-down": CaretDown,
  x: X,
  plus: Plus,
  minus: Minus,
  zap: Lightning,
  target: Target,
  pen: Pen,
  layout: Layout,
  search: MagnifyingGlass,
  "message-circle": ChatCircle,
  clock: Clock,
  shield: Shield,
  "shield-check": ShieldCheck,
  "trending-up": TrendUp,
  smartphone: DeviceMobile,
  globe: Globe,
  mail: EnvelopeSimple,
  phone: Phone,
  "map-pin": MapPin,
  instagram: InstagramLogo,
  linkedin: LinkedinLogo,
  twitter: XLogo,
  whatsapp: WhatsappLogo,
};

const PhosphorComponent = IconMap[name];
---

{
  PhosphorComponent && (
    <span
      aria-hidden={!label ? "true" : undefined}
      aria-label={label}
      role={label ? "img" : undefined}
      class:list={[
        "inline-flex items-center justify-center shrink-0",
        className,
      ]}
      style={color !== "currentColor" ? `color: ${color};` : ""}
    >
      <PhosphorComponent size={size} weight={weight} color="currentColor" />
    </span>
  )
}
