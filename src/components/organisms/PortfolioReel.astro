---
import Icon from "@atoms/Icon.astro";
import { portfolio } from "@data/site";
import { homeData } from "@data/home";

interface Props {
  id?: string;
  class?: string;
}

const { id = "portfolio", class: className = "" } = Astro.props;
---

<section
  id={id}
  class={`relative overflow-hidden ${className}`}
  aria-labelledby="portfolio-heading"
  style="background: var(--color-surface-overlay);"
>
  <div class="container-site pt-24 pb-10">
    <div class="flex items-end justify-between gap-8 flex-wrap mb-16">
      <div>
        <div data-reveal="up" class="mb-4">
          <span class="section-eyebrow">{homeData.portfolio.eyebrow}</span>
        </div>
        <h2
          id="portfolio-heading"
          data-reveal="up"
          data-reveal-delay="0.08"
          class="font-display font-extrabold text-primary"
          style="font-size: clamp(2rem, 4.5vw, 3.5rem); letter-spacing: -0.03em; line-height: 1.05;"
          set:html={homeData.portfolio.title}
        />
      </div>
      <div data-reveal="left" data-reveal-delay="0.1">
        <a
          href={homeData.portfolio.ctaHref}
          class="inline-flex items-center gap-2 text-sm font-semibold text-secondary hover:text-primary transition-colors duration-fast"
        >
          {homeData.portfolio.ctaText}
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </div>

  <!-- Horizontal scroll container — GSAP pin -->
  <div
    id="portfolio-pin-wrapper"
    class="relative portfolio-mobile"
    style="height: 280vh;"
    aria-label="Proyectos destacados"
  >
    <div
      id="portfolio-pin-inner"
      class="sticky top-0 h-screen flex items-center overflow-hidden"
    >
      <!-- Track — animated by GSAP via ScrollTrigger -->
      <div
        id="portfolio-track"
        class="flex gap-6 will-change-transform"
        style="padding: 0 max(24px, calc((100vw - 1320px)/2 + 64px));"
      >
        {
          portfolio.map((p) => (
            <article
              class="portfolio-card group relative flex-shrink-0 rounded-2xl overflow-hidden"
              style={`width: min(480px, 80vw); height: 70vh; background: ${p.bg}; border: 1px solid ${p.accent}18;`}
              aria-label={`${p.title} — ${p.category}`}
            >
              <!-- Top glow strip -->
              <div
                aria-hidden="true"
                class="absolute top-0 left-0 right-0 h-px"
                style={`background: linear-gradient(90deg, transparent, ${p.accent}70, transparent);`}
              />

              <!-- Reveal overlay -->
              <div
                aria-hidden="true"
                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-slow"
                style={`background: linear-gradient(135deg, ${p.accent}12 0%, transparent 60%);`}
              />

              <!-- A11y: real link wraps entire content -->
              <a
                href={`/portfolio/${p.id}`}
                class="absolute inset-0 p-8 md:p-10 flex flex-col justify-between focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
                style={`--tw-ring-color: ${p.accent};`}
                aria-label={`Ver proyecto: ${p.title}`}
              >
                <div class="flex items-start justify-between">
                  <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-[11px] tracking-widest uppercase font-medium"
                    style={`background: ${p.accent}14; color: ${p.accent}; border: 1px solid ${p.accent}25;`}
                  >
                    {p.category}
                  </span>
                  <span
                    class="text-muted text-xs"
                    style="font-family: 'JetBrains Mono', monospace;"
                  >
                    {p.year}
                  </span>
                </div>

                <!-- Wireframe mockup center -->
                <div
                  aria-hidden="true"
                  class="flex-1 flex items-center justify-center py-12"
                >
                  <div class="w-full max-w-xs space-y-3">
                    <div
                      class="h-2 rounded-full w-3/4 mx-auto"
                      style={`background: ${p.accent}30;`}
                    />
                    <div
                      class="h-8 rounded-lg w-full"
                      style="background: var(--color-surface-border);"
                    />
                    <div
                      class="h-8 rounded-lg w-4/5"
                      style="background: var(--color-surface-border);"
                    />
                    <div
                      class="h-4 rounded w-full mt-2"
                      style="background: var(--color-surface-border);"
                    />
                    <div
                      class="h-4 rounded w-5/6"
                      style="background: var(--color-surface-border);"
                    />
                    <div
                      class="h-10 rounded-xl w-36 mx-auto mt-4"
                      style={`background: ${p.accent}35;`}
                    />
                  </div>
                </div>

                <div>
                  <h3
                    class="font-display font-bold text-2xl text-primary mb-2"
                    style="letter-spacing: -0.02em;"
                  >
                    {p.title}
                  </h3>
                  <p class="text-secondary text-sm leading-snug mb-4">
                    {p.desc}
                  </p>
                  <span
                    class="inline-flex items-center gap-1.5 text-sm font-semibold"
                    style={`color: ${p.accent};`}
                  >
                    Ver proyecto
                    <Icon name="arrow-right" size={14} />
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <!-- Progress bar -->
      <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-3"
        aria-hidden="true"
      >
        <span class="text-muted text-xs font-mono">01</span>
        <div class="w-32 h-px bg-surface-card rounded-full overflow-hidden">
          <div
            id="portfolio-progress"
            class="h-full bg-brand-primary rounded-full"
            style="width: 0%;"
          />
        </div>
        <span class="text-muted text-xs font-mono"
          >0{portfolio.length}</span
        >
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initPortfolioReel = () => {
    gsap.registerPlugin(ScrollTrigger);
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── HORIZONTAL SCROLL (desktop only) ─────────────────────────
    const pinWrapper = document.getElementById("portfolio-pin-wrapper");
    const track = document.getElementById("portfolio-track");
    const progressBar = document.getElementById("portfolio-progress");

    if (pinWrapper && track && window.innerWidth >= 768 && !prefersReduced) {
      requestAnimationFrame(() => {
        const totalWidth = track.scrollWidth - window.innerWidth;

        gsap.to(track, {
          x: () => -totalWidth,
          ease: "none",
          scrollTrigger: {
            trigger: pinWrapper,
            start: "top top",
            end: () => `+=${pinWrapper.offsetHeight}`,
            scrub: 1,
            pin: "#portfolio-pin-inner",
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              if (progressBar)
                progressBar.style.width = `${self.progress * 100}%`;
            },
          },
        });
      });
    }
  };

  initPortfolioReel();
  document.addEventListener("astro:page-load", initPortfolioReel);
</script>

<style is:global>
  /* On mobile the GSAP pin is disabled; cards render as a 2-col grid instead. */
  @media (max-width: 767px) {
    #portfolio-pin-wrapper {
      height: auto !important;
    }
    #portfolio-pin-inner {
      position: static !important;
      height: auto !important;
      overflow: visible !important;
      padding-bottom: 2rem;
    }
    #portfolio-track {
      flex-wrap: wrap;
      transform: none !important; /* override GSAP translateX */
      width: auto !important;
      padding: 0 1rem;
      gap: 1rem;
      justify-content: center;
    }
    .portfolio-card {
      width: calc(50% - 0.5rem) !important;
      height: 320px !important;
      min-width: 140px;
    }
    #portfolio-progress,
    #portfolio-hint-desktop {
      display: none;
    }
  }
</style>
