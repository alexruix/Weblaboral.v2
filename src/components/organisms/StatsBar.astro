---
import { stats } from "@data/site";
import { homeData } from "@data/home";

interface Props {
  id?: string;
  class?: string;
}

const { id = "la-agencia", class: className = "" } = Astro.props;
---

<section
  id={id}
  class={`py-20 border-y border-surface relative overflow-hidden ${className}`}
  aria-labelledby="stats-heading"
>
  <h2 id="stats-heading" class="sr-only">{homeData.stats.heading}</h2>
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 80% 100% at 50% 50%, var(--color-glow-primary) 0%, transparent 70%);"
  >
  </div>
  <div class="container-site relative z-base">
    <div
      data-reveal-group
      class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-8 divide-x-0 lg:divide-x divide-surface"
    >
      {
        stats.map((s, i) => (
          <div
            data-reveal-item
            class:list={["text-center lg:text-left", i > 0 ? "lg:pl-8" : ""]}
          >
            <p
              class="counter font-display font-extrabold mb-1"
              style={`font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.04em; color: ${s.accent};`}
              data-target={s.value}
              data-decimals={s.decimals ?? 0}
              data-suffix={s.suffix ?? ""}
            >
              {s.value}
              {s.suffix}
            </p>
            <p class="text-secondary text-sm font-mono leading-snug">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initStatsBar = () => {
    gsap.registerPlugin(ScrollTrigger);
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── COUNTER ANIMATION ─────────────────────────────────────────────────
    document.querySelectorAll<HTMLElement>(".counter").forEach((el) => {
      const target = parseFloat(el.dataset.target ?? "0");
      const decimals = parseInt(el.dataset.decimals ?? "0", 10);
      const suffix = el.dataset.suffix ?? "";
      const obj = { val: 0 };

      ScrollTrigger.create({
        trigger: el,
        start: "top 85%",
        once: true,
        onEnter: () => {
          if (prefersReduced) {
            el.textContent = target.toFixed(decimals) + suffix;
            return;
          }
          gsap.to(obj, {
            val: target,
            duration: 1.8,
            ease: "power2.out",
            onUpdate: () => {
              el.textContent = obj.val.toFixed(decimals) + suffix;
            },
          });
        },
      });

      el.textContent = "0" + suffix;
    });
  };

  initStatsBar();
  document.addEventListener("astro:page-load", initStatsBar);
</script>
